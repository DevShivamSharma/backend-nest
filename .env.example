# Copy to .env and fill in. NEVER commit .env. Variable names are the same as in ITPO's backends.
# Every variable is validated at boot: a missing or malformed one aborts startup with a message
# naming it (it never prints the value).
#
# AUTH_JWT_SECRET must equal the AUTH_JWT_SECRET of ITPO's services (at least 32 characters),
# and REDIS_* must be the Redis they use, so ITPO's services accept the tokens this API issues.
# TRUST_PROXY (optional): how many load balancers sit in front, e.g. 1.
# ERROR_HTTP_STATUS (optional): "real" sends error responses with their real HTTP status;
# left out, they are HTTP 200 with the status in header.code, as ITPO's services answer.
NODE_ENV=development
APP_PORT=3010
APP_NAME="EMS"
API_PREFIX=ems/itpo/api
FRONTEND_DOMAIN=http://localhost:4200
BACKEND_DOMAIN=http://localhost:3010

DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

AUTH_JWT_SECRET=
AUTH_JWT_TOKEN_EXPIRES_IN=240m
AUTH_REFRESH_SECRET=
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# AI assistant of the planner (NVIDIA only). Get a key at build.nvidia.com; leave empty to switch it off.
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Outgoing mail. MAIL_TRANSPORT=log prints mails in the server log; smtp sends them (SMTP_* as ITPO admin).
MAIL_TRANSPORT=log
# Outside production every mail goes to these addresses (comma separated) instead of its own; empty: as addressed.
MAIL_REDIRECT_TO=
SMTP_HOST_NAME=
SMTP_PORT=465
SMTP_AUTH_USER=
SMTP_AUTH_PASSWORD=
SMTP_FROM_EMAIL=
# Who is mailed when an organiser sends or withdraws a hall (comma separated); empty: nobody.
ITPO_NOTIFY_EMAILS=
# Where the portal's web app is, for the links in mails.
APP_WEB_URL=http://localhost:4200
