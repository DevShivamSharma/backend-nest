# Copy to .env and fill in. NEVER commit .env.
# Every variable below is validated at boot. A missing or malformed one aborts startup with a
# message naming the variable — it never prints the value.

# --- Application -----------------------------------------------------------------------
# development | production | test
NODE_ENV=
# Default 8080.
PORT=
# Base URL of the web app, used in invitation and password-reset links.
APP_PUBLIC_URL=http://localhost:4200
# Comma-separated origin allow-list for the browser app.
CORS_ORIGINS=http://localhost:4200

# --- Database --------------------------------------------------------------------------
# Full postgres:// connection string. When set, the discrete DATABASE_* values are ignored.
# SUPABASE_DB_URL exists for platforms that reserve the DATABASE_URL name.
DATABASE_URL=
SUPABASE_DB_URL=
# TLS for the database connection: true | false. Defaults to true when a URL is set.
DATABASE_SSL=

DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

DATABASE_POOL_SIZE=
DATABASE_CONNECTION_TIMEOUT_MS=
DATABASE_STATEMENT_TIMEOUT_MS=

# --- Auth ------------------------------------------------------------------------------
# HMAC secret for access tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Access token lifetime in seconds (default 900) and refresh session lifetime in days (14).
JWT_ACCESS_TTL_SECONDS=
REFRESH_TOKEN_TTL_DAYS=
# Secure flag on the refresh cookie: true | false. Defaults to true in production.
COOKIE_SECURE=

# --- Mail ------------------------------------------------------------------------------
# log: emails (with their links) are written to the server log.
# smtp: sent through the SMTP server below (the same settings as ITPO's admin service).
MAIL_TRANSPORT=log
SMTP_HOST_NAME=
# 465 with SMTP_SECURE=true (the default); 587 with SMTP_SECURE=false.
SMTP_PORT=465
SMTP_SECURE=
SMTP_AUTH_USER=
SMTP_AUTH_PASSWORD=
SMTP_FROM_EMAIL=
# Outside production every email goes to these addresses instead (comma separated), so testing
# never mails real organisers or venue staff. Ignored in production.
MAIL_REDIRECT_TO=

# --- Super Admin (read only by `npm run admin:create`) ---------------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
# At least 10 characters.
SUPER_ADMIN_PASSWORD=

# --- AI assistant (planner) --------------------------------------------------------------
# Models to try in order: when one fails or hits its free limit, the next answers.
# Each cloud provider needs its key (free: console.groq.com, aistudio.google.com); one without a
# key is left out. Ollama runs locally at LLM_BASE_URL with LLM_TEXT_MODEL.
AI_PROVIDERS=groq,gemini,nvidia,ollama
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# build.nvidia.com: free credits, used when the ones before it are at their limit.
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Or a single provider, as before: AI_PROVIDER (gemini | groq | nvidia | ollama), AI_API_KEY, AI_MODEL.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TEXT_MODEL=qwen3:4b

# --- Bookings ----------------------------------------------------------------------------
# Minutes a held stall stays held unless it is confirmed (default 60, at most 10080).
BOOKING_HOLD_MINUTES=60

# --- Payments ----------------------------------------------------------------------------
# log: no gateway; fake orders, a dev endpoint marks them paid. razorpay: the real gateway.
# NODE_ENV=production refuses to start with log: set razorpay there.
PAYMENTS_TRANSPORT=log
# Key id and secret from the Razorpay dashboard (test mode: rzp_test_…). Never logged.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret set on the webhook in the Razorpay dashboard; verifies X-Razorpay-Signature.
# Required with razorpay when NODE_ENV=production; optional in development.
RAZORPAY_WEBHOOK_SECRET=

# --- Venue system push (docs/15 flow 1) ---------------------------------------------------
# Losing INTEGRATION_SECRET_KEY loses every venue secret; they are re-entered, not recovered.
# VENUE_CALLBACK_TRANSPORT: log (default; writes each push to the server log) or http.
# VENUE_CALLBACK_TIMEOUT_MS: how long one push waits for the venue (1000-60000, default 10000).
# INTEGRATION_SECRET_KEY: 32 random bytes, base64 (openssl rand -base64 32); required with http.
# VENUE_CALLBACK_TRANSPORT=
# VENUE_CALLBACK_TIMEOUT_MS=
# INTEGRATION_SECRET_KEY=

# --- Local quick-login (development only) -----------------------------------------------
# Comma-separated emails the quick-login page at / may sign in as without a password.
# Ignored when NODE_ENV=production. Leave empty to turn the page off.
# DEV_LOGIN_EMAILS=
