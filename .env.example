# Copy to .env and fill in. NEVER commit .env.
#
# This file exists because the Java put the database username and password as literal values
# in a committed application.properties (docs/07-risk-register.md R-02). Those credentials
# should be treated as compromised and rotated.
#
# Every variable below is validated at boot. A missing or malformed one aborts startup with a
# message naming the variable — it never prints the value.

# --- Application -----------------------------------------------------------------------
# development | production | test
NODE_ENV=
# Default 8080, matching the Java server.port, so frontend/src/App.js:8 keeps working.
PORT=

# --- Database --------------------------------------------------------------------------
# Full postgres:// connection string. Optional locally; deployment platforms with a managed
# database may inject it. When set, the discrete DATABASE_* values below are optional and
# ignored. Verdent project Secrets use SUPABASE_DB_URL because the platform reserves the
# DATABASE_URL name.
DATABASE_URL=
SUPABASE_DB_URL=
# TLS for the database connection: true | false. Defaults to true when DATABASE_URL is set
# (managed Postgres requires TLS), false otherwise.
DATABASE_SSL=

DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Explicit pool and timeout settings. The Java never configured HikariCP at all and ran on
# defaults that were never deliberately chosen (docs/05-integrations.md).
DATABASE_POOL_SIZE=
DATABASE_CONNECTION_TIMEOUT_MS=
DATABASE_STATEMENT_TIMEOUT_MS=

# --- Security --------------------------------------------------------------------------
# Comma-separated origin allow-list. Replaces @CrossOrigin(origins = "*") on all three Java
# controllers (docs/06-authentication.md S-01).
# Example: http://localhost:3000
CORS_ORIGINS=

# --- Limits ----------------------------------------------------------------------------
# Upper bound on the stalls array in a save/update request. The Java had none, and validation
# is O(n^2) inside a transaction (docs/07-risk-register.md R-07).
MAX_STALLS_PER_LAYOUT=

# Optional AI layout assistant. Leave blank to use the no-key simple parser.
# AI_PROVIDER: gemini | groq | grok. Set a model available to your provider account.
# Examples: gemini-2.5-flash | openai/gpt-oss-20b | grok-4-1-fast-non-reasoning
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
